# Copy to .env.local and fill in from the local Supabase stack:
#   npx supabase start
#   npx supabase status -o env
# Never commit .env.local or real keys.

# API_URL from supabase status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# PUBLISHABLE_KEY from supabase status (safe in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET_KEY from supabase status. Server-side scripts and tests only; never
# used by the app's routes.
SUPABASE_SECRET_KEY=

# Optional: debug, info, warn or error (default info)
LOG_LEVEL=info
